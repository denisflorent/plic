// Secrets.xcconfig.example
//
// Copy this file to Secrets.xcconfig, which is gitignored, and set
// DEVELOPMENT_TEAM to your Apple Developer Team ID. Xcode shows it under
// Settings > Accounts; it is also at https://developer.apple.com/account

DEVELOPMENT_TEAM = your_team_id_here

// Product identity. Changing BUNDLE_ID_PREFIX re-points every target's bundle
// identifier at once. The app group and the Swift-side constants that must
// match it are NOT derived from this — see AppGroup.swift in RelayKit and
// RelayShareExtension, which hardcode the group so the entitlements and the
// code can never silently drift apart.
BUNDLE_ID_PREFIX = im.plic
APP_DISPLAY_NAME = Plic

// The app target ships no CFBundleDisplayName/CFBundleName of its own, so set
// them here rather than in the project file: menu bar and Finder both read
// these, and keeping them out of the .pbxproj keeps upstream merges clean.
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_CFBundleName = $(APP_DISPLAY_NAME)
